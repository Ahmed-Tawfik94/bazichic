{
    "name": "bazi/bazichic",
    "description": "this is a bookstore that targeted towards chinese",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "Database/"
        }
    },
    "require": {
        "php": ">=7.4",
        "slim/slim": "^4.12.0",
        "slim/twig-view": "^3.3.0",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.6",
        "odan/slim-csrf": "^3.1",
        "dyorg/slim-token-authentication": "^0.3.3",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "google/recaptcha": "^1.2.4",
        "monolog/monolog": "^2.9",
        "stripe/stripe-php": "^16.1",
        "illuminate/database": "^8.83",
        "robmorgan/phinx": "^0.14.0",
        "symfony/yaml": "^5.4",
        "illuminate/pagination": "^8.83",
        "ext-json": "*",
        "fakerphp/faker": "^1.24",
        "mobiledetect/mobiledetectlib": "^3.74",
      "ext-gd": "*",
      "ext-fileinfo": "*"
    },
    "scripts": {
    "phinx": "vendor/bin/phinx",
    "make-model": "php make-model.php",
    "seed": "php vendor/bin/phinx seed:run -s",
    "seed-all": ["Composer\\Config::disableProcessTimeout","php vendor/bin/phinx seed:run"],
    "seed:create": "php vendor/bin/phinx seed:create",
    "migrate": "php vendor/bin/phinx migrate",
    "rollback": "php vendor/bin/phinx rollback"
},
    "license": "MIT"
}
