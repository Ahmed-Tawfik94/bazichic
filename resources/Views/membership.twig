{% extends 'layout.twig' %}
{% block content %}
    <div id="titlebar" class="bg-success text-white" style="margin-bottom: 0">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h2 class="text-white">Select Membership Plan</h2>
                    <nav id="breadcrumbs">
                        <ul>
                            <li><a class="text-white" href="{{ router.path_for('home') }}">Home</a></li>
                            <li><a class="text-white" href="{{ router.path_for('membership') }}">Membership</a></li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>
    </div>

    <!-- Container / Start -->
    <div class="container">
        <!-- Row / Start -->
        <div class="row">
            <div class="col-md-12">
                <div class="pricing-container my-4">
                    {% include 'partials/widgets/membership_plan.twig' %}
                </div>
            </div>
        </div>
        <!-- Row / End -->

    </div>
    <!-- Container / End -->
{% endblock content %}