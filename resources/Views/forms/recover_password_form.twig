<div id="recovery_overlay" style="display:none;">
    <div class="recovery-overlay-content">
        <img src="/images/preloader.gif" width="60" alt="Processing request..."/>
        <h4><strong>Processing...</strong></h4>
        <h5>Please wait...</h5>
        <div id="recovery_message_overlay" class="mt-3"></div>
    </div>
</div>

<div id="recovery_message_main" class="mt-3"></div>

<form method="POST"
      action="{{ base_url() }}/users/reset_password"
      class="login d-flex flex-column justify-content-between h-100 needs-validation"
      name="recoverPassForm"
      id="recoverPassForm"
      novalidate>

    <div class="text-center text-muted mb-3">
        <p>Enter your registered email and we will send you further instructions to
            access your account.</p>
        <p>Please do not forget to check your SPAM folder.</p>
    </div>

    <div class="form-group mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" class="form-control" id="email" name="email" aria-describedby="emailHelp" placeholder="Your registered email" required>
        <small id="emailHelp" class="form-text text-muted">Your registered email address.</small>
        <div class="invalid-feedback">
            Please provide a valid email address.
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="button btn btn-purple text-white w-100 mt-4">
            <i class="fa fa-unlock-alt"></i> Recover Password
        </button>
    </div>
</form>