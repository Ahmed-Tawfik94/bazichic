<div id="login_overlay" style="display:none;">
	<div style="margin: 30px; text-align: center;">
		<img src="{{base_url()}}/images/preloader.gif" width="60"/>
		<h4>
			<strong>Authenticating...</strong>
		</h4>
		<h5>Please wait...</h5>
		<div id="login_msg"></div>
	</div>
</div>

<form method="POST" action="{{full_url_for('login_controller')}}" class="login" name="loginForm" id="loginForm">
    <!-- CSRF Token Fields -->
    <input type="hidden" name="{{ csrf_name_key }}" value="{{ csrf_name }}">
    <input type="hidden" name="{{ csrf_value_key }}" value="{{ csrf_value }}">
    
	<div class="text-center">

		<p style="color:#333;font-weight:500;">Signin to access thousands of E-Books, Audio Books and Magazines brought to you by BaziChic. Don't have an account yet!
			<a href="{{full_url_for('register')}}" class="text-decoration-underline cursor-pointer">Register here.</a>
		</p>
	</div>
	<div class="form-group ">
		<label for="email">Email:</label>
		<i class="im im-icon-Male position-absolute"></i>
		<input type="email" class="form-control input-text position-relative"
			   id="email"
			   name="email"
			   pattern="^[A-Za-z0-9](([_\.\-]?[a-zA-Z0-9]+)*)@([A-Za-z0-9]+)(([\.\-]?[a-zA-Z0-9]+)*)\.([A-Za-z]{2,})$"
			   placeholder="Your registered email"
			   required>
	</div>
	<div class="form-group ">
		<label for="password">Password:</label>
		<i class="im im-icon-Lock-2 position-absolute"></i>
		<div class="position-relative">
			<i id="togglePassword" class="bi bi-eye position-absolute register_show_hide_pass" ></i>
			<input type="password" class="form-control input-text position-relative" id="password" name="password" placeholder="Your Password" required>
		</div>
{#		<input type="password" class="form-control input-text position-relative" id="password" name="password" placeholder="Your Password" required>#}
	</div>
	<div class="form-group">
		<a href="{{full_url_for('password-recovery')}}" class="text-decoration-none cursor-pointer">
			Password Recovery
		</a>
	</div>

		<div class="d-flex justify-content-center">
		<button type="submit" class="button btn btn-purple text-white">
			<i class="fa fa-unlock-alt"></i>
			Log In
		</button>
		</div>

</form>

<script>
	$(document).ready(function () {
		$('#togglePassword').on('click', function () {
			let passwordField = $('#password');
			let icon = $(this);

			if (passwordField.attr('type') === 'password') {
				passwordField.attr('type', 'text');
				icon.removeClass('bi-eye').addClass('bi-eye-slash');
			} else {
				passwordField.attr('type', 'password');
				icon.removeClass('bi-eye-slash').addClass('bi-eye');
			}
		});
	});
</script>