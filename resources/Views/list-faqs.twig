{% extends 'layout.twig' %}
{% block content %}
	<div id="titlebar" style="background-color:#284F4A;">
		<div class="container">
			<div class="row">
				<div class="col-md-12">
					<h3 style="color:#ffffff;font-weight:500;">{{ page.title }}</h3>
					<nav id="breadcrumbs">
						<ul>
							<li><a style="color:#ffffff;font-weight:500;"href="{{ full_url_for('home') }}">Home</a></li>
							<li><a style="color:#ffffff;font-weight:500;"href="{{ full_url_for('frequently-asked-questions')}}">FAQs</a></li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>

	<!-- Container / Start -->
	<div class="container">

		<div class="row">
			<div
				class="col-lg-9 col-md-8 padding-right-30">

				<!------ View Style 2----->
				<div class="row" style="margin-bottom:30px;">
					{% if page.data|length > 0 %}
						{% for row in page.data %}
							<div
								class="col-lg-12 col-md-12">

								{#                                <a href="{{ base_url() }}/faq/{{ row.qcode }}/{{ row.url }}">#}
								<div class="boxed-widget margin-top-10">
									<h4 style="font-weight:bold;color:#444444;">
										<i class="sl sl-icon-question"></i>
										{{ row.title }}</h4>
									<p style="font-weight:400;color:#444444;">{{ row.description|raw }}</p>
								</div>
								{#                                </a>#}
							</div>
						{% endfor %}
					{% else %}
						<div class="info-box text-center">
							<h2 style="color:#444444;font-weight:bold;">
								<i class="im im-icon-Folder-Search"></i>
							</h2>
							<hr>
							<h4 style="color:#444444;font-weight:bold;">No result found for your search.</h4>
							<h4 style="color:#444444;font-weight:bold;">Feel free to contact us if you have any question
																								                                that is not listed yet.</h4>
							<a href="{{ base_url() }}/contact" class="button btn btn-purple text-white margin-top-20">

								<i class="fa fa-envelope-o"></i>
								Contact Us</a>
						</div>
					{% endif %}
				</div>
				<!------ End of View Style 2----->


				<hr style="margin-top:30px;margin-bottom:40px;">
				<a href="{{ full_url_for('frequently-asked-questions')}}" class="button btn btn-purple text-white margin-top-20 margin-bottom-20 text-decoration-none text-white" style="display: block; margin: 0 auto; text-align: center; width:fit-content">


					<i class="fa fa-arrow-left"></i>
					View All FAQs
				</a>


			</div>
			<div class="col-lg-3 col-md-4">
				<div class="sidebar right">


					<div class="widget margin-bottom-10" style="text-align:center;">
						<div class="info-box">
							<h2>
								<i class="sl sl-icon-speech"></i>
							</h2>
							<hr>
							<p style="color:#333333;font-weight:bold;">Having a question that is not listed here? Feel
																								                                free to ask!</p>
							<a href="{{ base_url() }}/contact" class="button btn btn-purple text-white fullwidth margin-top-20">

								<i class="fa fa-envelope-o"></i>
								Contact Us</a>
						</div>
					</div>


					<div class="widget margin-top-20">
						<div class="info-box margin-bottom-20">
							<h4 style="font-weight:bold;">FAQs Categories</h4>
							{% if page.categories %}
								{% for rowdata in page.categories %}
									<p class="text-muted">
										{{ rowdata.title }}
									</p>
									{% if rowdata.subcategories|length > 0 %}
										<hr/>
										<ul class="nav">
											{% for rowmetadata in rowdata.subcategories %}
												<li class="nav-item text-info" style="list-style: none">
													<a href="{{ full_url_for('list-faqs',{qcode:rowmetadata.qcode})}}" class="nav-link px-2">
														<i class="fa fa-angle-right"></i>
														{{ rowmetadata.title }}
													</a>
												</li>
											{% endfor %}
										</ul>
									{% endif %}
								{% endfor %}
							{% endif %}
						</div>
					</div>


				</div>
			</div>
		</div>


	</div>
	<!-- Container / End -->
{% endblock content %}
