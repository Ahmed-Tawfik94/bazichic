{% set layout_template = session.userID == 1 ? 'admin/admin_layout.twig' : 'layout.twig' %}
{% extends layout_template %}
{% block content %}
<div class="container">
	<div class="row">
		<div class="col-md-12">

			<section id="not-found" class="center">
				<h2><i class="fa fa-question-circle"></i></h2>
				<p>We're sorry, but the page you were looking for doesn't exist.</p>

				<!-- Search -->
				<div class="row">
					<div class="col-lg-8 col-lg-offset-2">
						<a href="{{base_url()}}" class="button btn btn-purple text-white">Go to Home page</a>
					</div>
				</div>
			</section>

		</div>
	</div>

</div>
<!-- Container / End -->
{% endblock content %}