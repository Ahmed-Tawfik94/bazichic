{% extends 'dashboard_layout.twig' %}
{% block content %}
    <div class="row ">

        <!-- Listings -->
        <div class="col-lg-12 col-md-12 pb-4">
            <div class="card" style="border-radius: 12px!important;">
                <div class="card-header bg-white rounded-top-12 py-3 d-flex justify-content-between align-items-center">
                    <h4> <i class="fa fa-bell mr-2"></i>Notifications ({{ num_of_all_notifications }}) </h4>
                </div>
                <div class="card-body">
                    {% if notifications %}
                        <ul class="list-group list-group-flush">
                            {% for notification in notifications %}
                                {% include 'list_items/notification_list_item.twig' %}
                            {% endfor %}
                        </ul>
                    {% else %}
                        <section style="margin: 40px 0 80px 0;text-align: center;margin-bottom:30px;" class="center">
                            <h1 style="text-align: center;font-weight: 500;"><i class="fa fa-bell"></i></h1>
                            <h4>There is nothing for you to attend here. We will notify you when something happens.</h4>

{#                            <!-- Search -->#}
                            <div class="row" style="margin-top:20px;">
                                <div class="col-lg-8 col-lg-offset-2">
                                    <a href="{{ full_url_for('dashboard') }}" class="button btn btn-purple text-white" style="margin-bottom:30px;"><i
                                                class="fa fa-arrow-left"></i> Back to Dashboard</a>
                                </div>
                            </div>
                        </section>
                    {% endif %}
                </div>
            </div>
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-end">
                    {% for link in pagination.links %}

                    <li class="page-item{% if link.active %} active text-white {% endif %} {% if (not pagination.prev_page_url and link.label == 'Previous') or (not pagination.next_page_url and link.label == 'Next' )%}disabled{% endif %}">
                        <a class="page-link {% if not link.active %}text-dark {% endif %}" href="/users/notification{{  link.url }}">{{ link.label  }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </nav>

            <!-- Pagination -->
            <div class="clearfix"></div>
