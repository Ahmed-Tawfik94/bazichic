<script id="hourly" type="text/template">
    {{#each hourly_details}}
    <div class="hourly-card">
        <div class="hourly-time">{{this.timeRange}}</div>
        <div class="hourly-content">
            <div class="stem-branch"> {{this.stemBranch}}</div>
            <div>({{this.stemBranchEn}})</div>
            <div class="activity">{{this.activity}}</div>
            <ul class="details-list">
                {{#each this.details}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
    </div>
    {{/each}}
</script>