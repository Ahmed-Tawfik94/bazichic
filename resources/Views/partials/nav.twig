<div class="navbar navbar-expand-md navbar-primary position-relative ">
    <a class="navbar-brand" href="{{ full_url_for('home') }}">
            <img src="/images/logo.png" alt="BaziChic Chinese Metatphysics Consultancy" width="64" />
	</a>
        <button class="navbar-toggler border-0" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list" style="font-size:20px"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item active">
                    <a class="nav-link" href="{{ full_url_for('home') }}">Home <span class="sr-only">(current)</span></a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ full_url_for('e-book-store') }}">Browse</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ full_url_for('about') }}">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ full_url_for('contact') }}">Contact Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ full_url_for('calendar') }}">e-TongShu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ full_url_for('frequently-asked-questions') }}">Help Centre</a>
                </li>

            </ul>
            {% if session.first_name and  session.last_name and session.email %}
            <div class="dropdown px-0 px-md-4" style="user-select: none;">
                <a class="dropdown-toggle text-decoration-none text-dark " type="button" data-toggle="dropdown" aria-expanded="false">
                    {% if session.user_image %}
                        <img src="/{{ session.user_image }}" alt="{{ session.first_name }}" class="rounded-full" width="40" height="40">
                    {% else %}
                        <img src="/images/avatar.jpg" alt="placeholder" class="rounded-full"  width="40" height="40">
                    {% endif %}
                    {{ session.first_name }}
                </a>
                <div class="dropdown-menu right-0">
                    <a class="dropdown-item" href="{{ full_url_for('dashboard')}}"><i class="fa fa-line-chart mr-2"></i>Dashboard</a>
                    <a class="dropdown-item" href="{{ full_url_for('logout')}}"><i class="sl sl-icon-power mr-2"></i>Logout</a>
                </div>
            </div>
            {% else %}
                <a href="#sign-in-dialog" class="sign-in popup-with-zoom-anim text-decoration-none btn-link text-dark"  style="user-select: none;">
                    <i class="sl sl-icon-login"></i>
                    Login</a>
            {% endif %}
        </div>

        <!-- Sign In Popup -->
        <div id="sign-in-dialog" class="zoom-anim-dialog mfp-hide">
            <div class="small-dialog-header">
                <h3>Sign In</h3>
            </div>
            <div class="sign-in-form style-1">
                {% include 'forms/login_form.twig' %}
            </div>
        </div>
        <!-- Sign In Popup / End -->
</div>
{# <div class="row d-none d-md-flex"> #}
    <div class="col-lg-12 col-md-12 col-sm-12 d-none d-md-block " >
        {% include 'forms/noboot-search-form.twig' %}
    </div>
{# </div> #}