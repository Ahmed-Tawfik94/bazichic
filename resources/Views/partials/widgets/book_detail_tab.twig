<!-- Listing Nav -->
<div id="listing-nav" class="listing-nav-container">
    <ul class="listing-nav">
        <li><a href="#listing-overview" class="active">Description</a></li>
        <li><a href="#listing-author">About Author</a></li>
        <li><a href="#listing-reviews">Reviews</a></li>
        <li><a href="#add-review">Add Review</a></li>
    </ul>
</div>

<!-- Overview -->
<div id="listing-overview" class="listing-section container">
    <p>{{ document.description }}</p>
    <h4 class="listing-desc-headline"> {{ document.doc_type }} Details</h4>
    <ul class="nav flex-wrap" style="gap: 10px">
        <li class="nav-item"><i class="sl sl-icon-tag"></i> Category: {{ document.category }}</li>
        <li class="nav-item"><i class="sl sl-icon-info"></i> Code: {{ document.qcode }}</li>
        {% if document.num_pages > 0 %}
            <li class="nav-item"><i class="sl sl-icon-book-open"></i> Total Pages: {{ document.num_pages }}</li>
        {% endif %}

        {% if document.num_likes > 0 %}
            {% if document.is_liked > 0 %}
                <li class="nav-item">
                    <i class="fa fa-heart" style="color:#f92b60 !important;"></i>
                    {% if document.num_likes > 1 %}you & {{ ( document.num_likes - 1 )|pluralize('other', 'others') }}.{% else %}
                        <small>{{ document.num_likes }}</small> {% endif %}
                </li>
            {% else %}
                <li class="nav-item">
                    <i class="sl sl-icon-heart"></i>
                    Liked by {{ document.num_likes|pluralize('other', 'others') }}.
                </li>
            {% endif %}
        {% endif %}

        {% if document.read_time > 0 %}
            <li><i class="im im-icon-Timer-2"></i> Read Time: {{ document.read_time }} Minutes</li>{% endif %}
        {% if document.listen_time > 0 %}
            <li><i class="im im-icon-Hipster-Headphones"></i> Listen Time: {{ document.listen_time }} Minutes
            </li>{% endif %}
    </ul>
</div>

<!-- Author -->
{% if document.audio_file  %}
<div id="listing-author" class="listing-section container">
    <h3 class="listing-desc-headline margin-top-60 margin-bottom-30">{{ document.doc_type }} Audio</h3>
    {% include 'partials/widgets/audioplayer.twig' %}

</div>
{% endif %}
<div id="listing-author" class="listing-section container">
    <h3 class="listing-desc-headline margin-top-60 margin-bottom-30"></h3>

    <div id="singleListingMap-container">
        <p style="font-weight:500;">{{ document.author_name }}</p>
        {% if document.author_link %}<a href="{{ document.author_link }}" target="_blank" class="button btn btn-purple text-white text-decoration-none text-white"><i
                    class="fa fa-link"></i> Read More</a>{% endif %}
    </div>
</div>

<!-- Reviews -->
{% include 'partials/widgets/list_doc_reviews.twig' %}

<!-- Add Review Box -->
<div id="add-review" class="add-review-box">
    {% include 'forms/dialog_document_review_form.twig' %}
</div>
<!-- Add Review Box / End -->