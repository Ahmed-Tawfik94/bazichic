
<!-- Container for Membership Plans -->
<div  class="d-flex flex-column justify-content-center align-items-center ">
    <div class="text-center my-4 ">
        <button id="toggle-monthly" class="btn btn-primary active">Monthly</button>
        <button id="toggle-yearly" class="btn btn-secondary">Yearly</button>
    </div>
    <div id="membership-plans-container" class="row w-100"></div>
</div>

<script id="membership-template"  type="text/template">
    <%#plans%>
    <div class="col-12 col-md-<%col_class%> wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
        <div class="single-pricing <%#is_highlighted%>single-pricing-white<%/is_highlighted%>">
            <div class="price-head">
                <h2><%name%></h2>
                <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <%#is_highlighted%>
            <span class="price-label">Best</span>
            <%/is_highlighted%>
            <h1 class="price">$<%price%></h1>
            <h5><%interval%>ly</h5>
            <%#description%>
            <div style="height: 100px" class="my-3 p-4"><%description%></div>
            <%/description%>
            <%#is_selected%>
            <button class="text-decoration-none btn-secondary" disabled>Selected</button>
            <%/is_selected%>
            <%^is_selected%>
            <a class="text-decoration-none" href="<% switch_url %>"><% switch_text %></a>
            <%/is_selected%>
        </div>
    </div>
    <%/plans%>
</script>
<script src="https://unpkg.com/mustache@latest"></script>
<script>
    const customTags = [ '<%', '%>' ];
    Mustache.tags = customTags;
</script>
<script>
    $(document).ready(function() {

        let plansData = JSON.parse('{{ page.membership_plans |json_encode |raw }}')
        function renderPlans(type) {
        console.log(plansData[type])
            let template = $("#membership-template").html();
            let plans = plansData[type].map(plan => ({
                ...plan,
                col_class: plansData[type].length === 2 ? "6" : plansData[type].length === 3 ? "4" : "12",
                switch_text: plan.is_selected ? "Selected" : (plansData[type].some(p => p.is_selected) ? "Switch" : "Select Plan"),
                switch_url: `/membership/member/${plan.id}`
            }));
            $("#membership-plans-container").html(Mustache.render(template, { plans }));
        }

        // Default to Monthly
        renderPlans("month");

        // Toggle between Monthly & Yearly
        $("#toggle-monthly").click(function() {
            renderPlans("month");
            $("#toggle-monthly").addClass("btn-primary active").removeClass("btn-secondary");
            $("#toggle-yearly").addClass("btn-secondary").removeClass("btn-primary active");
        });

        $("#toggle-yearly").click(function() {
            renderPlans("year");
            $("#toggle-yearly").addClass("btn-primary active").removeClass("btn-secondary");
            $("#toggle-monthly").addClass("btn-secondary").removeClass("btn-primary active");
        });
    });
</script>
