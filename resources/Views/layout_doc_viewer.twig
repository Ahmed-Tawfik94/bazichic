<!DOCTYPE html>
<head>
	<title>{{ page.title }}</title>
	<meta charset="utf-8">
	<meta name="description" content="{{ page.description }}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="shortcut icon" type="image/png" href="{{ base_url() }}/images/favicon.png"/>
	<link rel="stylesheet" href="{{ base_url() }}/css/style.css">
	<link rel="stylesheet" href="{{ base_url() }}/css/custom.css">
	<link
	rel="stylesheet" href="{{ base_url() }}/css/colors/main.css" id="colors">
	{# //  <script type="text/javascript" app="{{ base_url() }}/scripts/jquery-2.2.0.min.js"></script> #}
	<script type="text/javascript" src="{{ base_url() }}/scripts/jquery-3.7.1.min.js"></script>
	<script type="text/javascript" src="{{ base_url() }}/scripts/front_script.js"></script>
	<link href="{{ base_url() }}/docreader/css/bazichikereader.css" rel="stylesheet" type="text/css">
	<link href="{{ base_url() }}/docreader/css/themify-icons.css" rel="stylesheet" type="text/css">
	<script src="{{ base_url() }}/docreader/js/libs/jquery.min.js" type="text/javascript"></script>
	{#<script app="docreader/js/dflip.min.js" type="text/javascript"></script>#}
	<script src="{{ base_url() }}/docreader/js/dflip.js" type="text/javascript"></script>
	<script src="{{ base_url() }}/docreader/js/libs/pdf.js" type="text/javascript"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous"> {% block jstrigger %}{% endblock %}
	</head>
	<body>
		<div
			id="wrapper">
			<!------- Header ------>
			<div class="clearfix"></div>
			{% block slider %}{% endblock %}

			<div class="dark" style="position:fixed;bottom:0;left:0;width:100%;">
				<div class="d-flex flex-column-reverse flex-md-column align-items-center vh-100 p-2" style="height: calc(100vh - 30px) !important;">
					{% if page.allowReading %}
						<div class="d-flex justify-content-between align-items-center p-4 w-100">
							<a href="{{ base_url() }}/e-book-store">
								<button class="button btn btn-purple text-white text-left">
									<i class="sl sl-icon-arrow-left"></i>
								</button>
							</a>

							<form id="saveMyReadForm" name="saveMyReadForm" action="{{full_url_for('save-document')}}" class="form-horizontal" method="POST" style="display:inline-block;">
								<input type="hidden" name="user_id" value="{{session.userID}}">
								<input type="hidden" name="doc_id" value="{{page.doc_id}}">
								<input type="hidden" name="page" id="page" value="">
								<input type="hidden" name="progress" id="progress" value="0">

								<button type="submit" class="button btn btn-purple text-white text-right">
									<i class="im im-icon-Arrow-LeftinCircle"></i>SAVE THIS READ</button>
							</form>

							<div id="saveMyReadLoader" style="display:none;">
								<button class="button btn btn-purple text-white text-right">
									<i class="im im-icon-Arrow-LeftinCircle"></i>Saving...</button>
							</div>
						</div>

					{% endif %}
					{% block content %}{% endblock %}
				</div>

				<div class="row" style="background-color:#444444;">
					<div class="col-md-12">
						<div style="text-align:center;color:#ffffff;">© 2021 |
							<a href="{{base_url()}}" target="_blank" style="color:#ffffff;font-weight:bold;">BaziChic Chinese Metaphysics Consulting</a>
							| All Rights Reserved.</div>
					</div>
				</div>
			</div>


			<div id="backtotop">
				<a href="#"></a>
			</div>
		</div>
		{# // <script app="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script> #}
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
		<script type="text/javascript" src="{{ base_url() }}/scripts/mmenu.min.js"></script>
		<script type="text/javascript" src="{{ base_url() }}/scripts/chosen.min.js"></script>
		<script type="text/javascript" src="{{ base_url() }}/scripts/jquery-ui.min.js"></script>
		<script type="text/javascript" src="{{ base_url() }}/scripts/tooltips.min.js"></script>
		<script type="text/javascript" src="{{ base_url() }}/scripts/custom.js"></script>
		<script src="{{ base_url() }}/scripts/sweetalert2.all.min.js"></script>
		<script>
			document.addEventListener("DOMContentLoaded", function () { // Prevent closing the login modal when interacting with SweetAlert
				$('#sign-in-dialog').on('hide.bs.modal', function (e) {
				if (Swal.isVisible()) {
				e.preventDefault(); // Stop the modal from closing
				}
				});
				});
		</script>

	</body>
</html>
