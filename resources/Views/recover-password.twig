{% extends 'layout.twig' %}
{% block slider %}
{% endblock %}
{% block content %}
    <div class="container">
        <div class="row margin-top-10">
            <div class="col-lg-6">
                <div class="boxed-widget" style="z-index: 50;
    box-sizing: border-box;border-radius: 4px;margin:15px;">
                    <div class="text-center">
                        <!-- Headline -->
                        <div class="text-center">
                            <h2><i class="im im-icon-Mail-Password " style="font-weight:bold;"></i></h2>
                            <h3 class="text-muted" >Password Recovery</h3>
                        </div>
                        <div class="inner">

                            <p class="text-muted" >Have you registered an account and did not receive
                                your password yet? Or have you forgotten the password that you have been using. You can
                                reset your password by entering your registered email address. We will send you an email
                                with instructions to access your account.</p></div>
                        <a href="{{ full_url_for('login') }}" class="button btn btn-purple text-white fullwidth margin-top-25 text-decoration-none text-white"><i
                                    class="fa fa-user"></i> Login Now</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-flex justify-content-center align-items-stretch">
                <div class="boxed-widget" style="padding:30px;z-index: 50;box-sizing: border-box;border-radius: 4px;margin:15px;">

                    {% include 'forms/recover_password_form.twig' %}

                </div>
            </div>
            <div class="col-lg-2"></div>
        </div>
    </div>

{% endblock %}