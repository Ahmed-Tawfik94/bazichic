<!DOCTYPE html>
<html>
<head>
    <title>Password Reset for {{ name|e }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
        }
        .email-container {
            max-width: 600px;
            margin: 50px auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .logo img {
            height: 60px;
            margin-bottom: 20px;
        }
        a {
            color: #007BFF;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .cta-button {
            display: inline-block;
            background: #007BFF;
            color: #fff !important;
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none !important;
            margin-top: 20px;
        }
    </style>
</head>
<body>
<div class="email-container">
    <a href="{{ base_url }}" class="logo">
        <img src="{{ base_url }}/images/logo.png" alt="Bazichic">
    </a>
    <h4>Hello {{ name|e }},</h4>
    <p>We have successfully reset the password for your account. Your new password is:</p>
    <p><strong>{{ password|e }}</strong></p>
    <p>Use this password to access your account.</p>
    <a href="{{ base_url }}/login" class="cta-button">Click here to Sign In</a>
    <p>For more details, visit our official site at <a href="{{ base_url }}">www.bazichic.com</a>.</p>
</div>
</body>
</html>
