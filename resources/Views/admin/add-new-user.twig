					<h3 style="color:#121212;margin-top:30px;"><strong>Creating Account</strong></h3>
					<h4 style="color:#232323;">Please wait...</h4>
					</div>	
					</div>	
					</div></div>
					<!-- Section / End -->
				
				

{% include 'admin/forms/create_user_account.twig' %}
{% endblock content %}