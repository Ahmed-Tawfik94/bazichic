{% extends 'admin/admin_layout.twig' %}
{% block content %}
    <div class="card" style="border-radius: 12px !important;">
        <div class="card-header rounded-top-12 bg-white">
            <h4 class="py-2"><i class="bi bi-bell-fill mr-2"></i> Blast Notification</h4>
        </div>
        <div class="card-body">
            <div>
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="form-group">
                    <label for="blastmessage">Message</label>
                    <textarea class="form-control " id="blastmessage" name="blastmessage" rows="4" style="resize: none"></textarea>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" id="blast_notification" class="btn btn-outline-dark rounded-pill"><i class="bi bi-send-fill mr-2"></i>Blast</button>
                </div>
            </div>
        </div>
    </div>

{% endblock content %}
{% block jsfooter %}

    <script>
        const url ='{{ full_url_for('blast-notification') }}';
        const formNotification = $('button#blast_notification');
        const showConfirmationMessage=(title, message,type,callback=null)=>{
            swal({
                title: title,
                html: "<b>" + message + "</b>",
                type: type,
                showCancelButton: false,
                allowOutsideClick: false,
                confirmButtonColor: "#3085d6",
                focusConfirm: false,
            }).then(result => {
                if(typeof callback ==='function'){
                    callback(result)
                }
                    return
            });
        }

        formNotification.on('click', async () => {
            const title = $('#title');
            const message = $('#blastmessage');

            if (title.val().trim() === '' || message.val().trim() === '') {
                showConfirmationMessage('Fields Required', 'Title or Message are required fields', 'error');
                // console.log("Title or Message are required fields")
                return;
            }

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    body: JSON.stringify({
                        title: title.val(),
                        message: message.val()
                    }),
                    headers: {
                        'Authorization': authorization,
                        'Content-Type': 'application/json'
                    }
                });

                if (!res.ok) {
                    const errorData = await res.json();
                    showConfirmationMessage('Error Found', errorData.message || "An error occurred", 'error');
                    return;
                }

                const responseData = await res.json();
                // console.log(responseData)
                // responseData.redirection_url = responseData?.redirection_url || undefined;

                // Show success message and reset form fields
                await showConfirmationMessage('Notification Send', responseData.message, 'success', (result) => {
                    if (result.value) {
                        title.val('');  // Reset the title field
                        message.val('');  // Reset the message field
                    }
                });

            } catch (e) {
                showConfirmationMessage('Failed', e.message, 'error');
                // console.error(e)
            }
        });
    </script>
{% endblock %}