{% extends 'admin/admin_layout.twig' %}

{% block title %}
	<title>{{ plan.name }}</title>
	<meta name="title" content="{{ plan.name }}">
	<meta name="description" content="{{ plan.description }}">
{% endblock %}
{% block jstriggers %}
	<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/additional-methods.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/additional-methods.min.js"></script>
{% endblock %}
{% block content %}
	<!-- Price Tier Template -->
	<script id="price-tier-template" type="text/template">
		<div class="price-tier card mb-3" data-tier-id="<%tierId%>">
			<div class="card-body">
				<div class="form-row justify-content-center align-items-center"> <!-- Changed from row g-3 to form-row -->
					<div class="col-md-4 form-group"> <!-- Added form-group -->
						<label for="price_id_<%tierId%>" class="form-label">Price</label>
						<div class="input-group">
							<input type="text"
								   id="price_id_<%tierId%>"
								   class="form-control price-input"
								   name="prices[<%tierId%>][amount]"
								   value="<%price%>"
								   required>
						</div>
					</div>
					<div class="col-md-4 form-group">
						<label for="prices[<%tierId%>][interval]">Interval</label>
						<select id="prices[<%tierId%>][interval]"
								name="prices[<%tierId%>][interval]"
								class="form-control interval-select"
								required>
							<%#intervals%>
							<%#selected%>
								<option value="<%value%>" selected><%name%></option>
							<%/selected%>
							<%^selected%>
								<option value="<%value%>"><%name%></option>
							<%/selected%>
							<%/intervals%>
						</select>
					</div>
					<div class="col-md-3 form-group">
						<label for="prices[<%tierId%>][active]">Active</label>
						<div class="custom-control custom-switch mt-2"> <!-- Changed to Bootstrap 4 custom switch -->
							<%#active%>
							<input type="checkbox"
								   class="custom-control-input"
								   id="prices[<%tierId%>][active]"
								   name="prices[<%tierId%>][active]"
								   checked>
							<label class="custom-control-label" for="prices[<%tierId%>][active]">&nbsp;</label>
							<%/active%>
							<%^active%>
							<input type="checkbox"
								   class="custom-control-input"
								   id="prices[<%tierId%>][active]"
								   name="prices[<%tierId%>][active]">
							<label class="custom-control-label" for="prices[<%tierId%>][active]">&nbsp;</label>
							<%/active%>
						</div>
					</div>
					<div class="col-md-1">
						<%#isFirst%>
						<button type="button" class="btn btn-outline-danger remove-tier"> <!-- Changed to d-none -->
							<i class="bi bi-trash"></i> <!-- Changed to Font Awesome instead of Bootstrap Icons -->
						</button>
						<%/isFirst%>
						<%^isFirst%>
						<button type="button" class="btn btn-outline-danger remove-tier">
							<i class="bi bi-trash"></i>
						</button>
						<%/isFirst%>
					</div>
				</div>
			</div>
		</div>
	</script>

	<div class="card" style="border-radius: 12px!important;">
		<div class="card-header bg-white rounded-top-12">
			<h3>{{ page.title }}</h3>
		</div>


		<div class="card-body">
			<div>
				<div class="form-group mb-4">
					<h2>{{ plan.name }} Plan</h2>
				</div>

				<div class="form-group mb-4">
					<label for="description" class="form-label">Description:</label>
					<p>{{ plan.description }}</p>
				</div>
			</div>
			<form action="{{full_url_for('update-membership-plan',{id:plan..stripe_product_id})}}" method="POST" id="updateMembershipForm" name="updateMembershipForm">
				<div class="pricing-section mb-4">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4 class="mb-0">Pricing Tiers</h4>
						<button type="button" class="btn btn-outline-primary rounded-pill" id="addPriceBtn">
							<i class="bi bi-plus"></i>Add Price Tier
						</button>
					</div>

					<div id="pricingTiers">
						<!-- Price tiers will be rendered here -->
					</div>
				</div>

				<div class="d-flex justify-content-between py-4">
					<button type="button" class="btn btn-outline-secondary rounded-pill" onclick="window.history.back()">Cancel</button>
					<button type="submit" class="btn btn-primary rounded-pill">Update Subscription</button>
				</div>
			</form>
		</div>
	</div>

{#	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>#}
{#	<script src="https://cdnjs.cloudflare.com/ajax/libs/mustache.js/4.2.0/mustache.min.js"></script>#}
<script>
	$(document).ready(function() {
		const config = {
			intervals: [
				{ value: 'month', name: 'Monthly', selected: true },
				{ value: 'year', name: 'Yearly' }
			]
		};

		let tierCounter = 0;
		let originalFormState = {};
		const $updateButton = $('button[type="submit"]');

		// Add custom validation method for price
		$.validator.addMethod("validPrice", function(value, element) {
			const price = parseFloat(value);
			return !isNaN(price) && price > 0;
		}, "Please enter a valid price greater than 0");

		// Initialize form validation
		const validator = $('#updateMembershipForm').validate({
			// Validation configuration
			ignore: [], // Don't ignore hidden fields
			errorElement: 'div',

			// Error placement
			errorPlacement: function(error, element) {
				error.addClass('invalid-feedback');
				if (element.hasClass('price-input')) {
					error.insertAfter(element.closest('.input-group'));
				} else {
					error.insertAfter(element);
				}
			},

			// Highlight errors
			highlight: function(element) {
				$(element).addClass('is-invalid');
			},

			// Remove highlight on valid
			unhighlight: function(element) {
				$(element).removeClass('is-invalid');
			},

			// Custom submit handler
			submitHandler: async function(form, event) {
				event.preventDefault();
				try {
					const dialog = await swal({
						title: "Update price tier",
						html: "Are you sure you want to update this product prices",
						type: "warning",
						showCancelButton: true,
						allowOutsideClick: true,
						confirmButtonColor: "#3085d6",
						focusConfirm: true,
					});

					if (dialog.value) {
						const formData = {
							prices: collectFormData()
						};

						const response = await $.ajax({
							url: "{{full_url_for('update-membership-plan',{id: plan.stripe_product_id})}}",
							type: "POST",
							contentType: "application/json",
							data: JSON.stringify(formData)
						});

						if (!response.success) {
							throw new Error(response.message);
						}

						toastr.success('Membership plan updated successfully!');

						setTimeout(() => {
							if(response.redirect_url){
							window.location.href = response.redirect_url;
							}else{
								window.location.reload()
							}
						}, 1500);
					}
				} catch (error) {
					toastr.error(error.message || 'Failed to update membership plan');
				}
			}
		});

		function collectFormData() {
			const prices = {};
			$('.price-tier').each(function() {
				const tierId = $(this).data('tier-id');
				prices[tierId] = {
					amount: parseFloat($(this).find('.price-input').val()),
					interval: $(this).find('.interval-select').val(),
					active: $(this).find('.custom-control-input').is(':checked')
				};
			});
			return prices;
		}

		function captureOriginalState($tier) {
			const tierId = $tier.data('tier-id');
			originalFormState[tierId] = {
				amount: parseFloat($tier.find('.price-input').val()),
				interval: $tier.find('.interval-select').val(),
				active: $tier.find('.custom-control-input').is(':checked')
			};
		}

		function hasStateChanged() {
			const currentState = collectFormData();
			let changed = false;

			// Compare each tier
			Object.keys(currentState).forEach(tierId => {
				if (!originalFormState[tierId]) {
					changed = true;
					return;
				}

				const current = currentState[tierId];
				const original = originalFormState[tierId];

				if (current.amount !== original.amount ||
						current.interval !== original.interval ||
						current.active !== original.active) {
					changed = true;
				}
			});

			// Check for removed tiers
			if (Object.keys(originalFormState).length !== Object.keys(currentState).length) {
				changed = true;
			}

			return changed;
		}

		function updateButtonState() {
			const isValid = $('#updateMembershipForm').valid();
			const hasChanges = hasStateChanged();
			$updateButton.prop('disabled', !isValid || !hasChanges);
		}

		function createPriceTier(data = {}) {
			tierCounter++;
			const templateData = {
				tierId: tierCounter,
				price: data.price || '0.00',
				intervals: config.intervals.map(int => ({
					...int,
					selected: int.value === data.interval
				})),
				active: data.active !== false,
				isFirst: tierCounter === 1
			};

			const template = $('#price-tier-template').html();
			const rendered = Mustache.render(template, templateData);
			$('#pricingTiers').append(rendered);

			const $newTier = $(`[data-tier-id="${tierCounter}"]`);

			// Set name attribute for validation
			$newTier.find('.price-input').attr('name', `price_${tierCounter}`);
			$newTier.find('.interval-select').attr('name', `interval_${tierCounter}`);

			// Add validation rules
			$(`[name="price_${tierCounter}"]`).rules('add', {
				required: true,
				validPrice: true,
				messages: {
					required: "Price is required",
					validPrice: "Please enter a valid price greater than 0"
				}
			});

			initializeTier($newTier);

			if (data.price) {
				captureOriginalState($newTier);
			}

			updateButtonState();
		}

		function initializeTier($tier) {
			$tier.find('.price-input')
					.on('input', function() {
						let value = $(this).val();
						if (!/^\d*\.?\d*$/.test(value)) {
							$(this).val(value.replace(/[^0-9.]/g, ''));
						}
						validator.element(this);
						updateButtonState();
					})
					.on('blur', function() {
						let value = $(this).val();
						if (value && !isNaN(value)) {
							$(this).val(parseFloat(value).toFixed(2));
						}
						validator.element(this);
						updateButtonState();
					});

			$tier.find('.interval-select').on('change', function() {
				updateButtonState();
			});

			$tier.find('.custom-control-input').on('change', function() {
				updateButtonState();
			});
		}

		// Add initial price tiers
		const prices = JSON.parse('{{ plan.prices | json_encode | raw }}');
		prices.forEach((price, idx) => {
			createPriceTier({
				price: price,
				interval: JSON.parse('{{ plan.intervals |json_encode|raw}}')[idx],
				active: Boolean(JSON.parse('{{ plan.is_available |json_encode|raw}}')[idx])
			});
		});

		// Add new price tier button
		$('#addPriceBtn').on('click', function() {
			createPriceTier();
		});

		// Remove price tier
		$('#pricingTiers').on('click', '.remove-tier', function() {
			const $tier = $(this).closest('.price-tier');

			swal({
				title: "Remove Price Tier",
				html: "Are you sure you want to delete this price tier",
				type: "error",
				showCancelButton: true,
				allowOutsideClick: true,
				confirmButtonColor: "#3085d6",
				focusConfirm: true,
			}).then(({value}) => {
				if (value) {
					$tier.fadeOut(300, function() {
						$(this).remove();
						updateButtonState();
					});
				}
			});
		});

		// Initial button state
		$updateButton.prop('disabled', true);
	});
</script>
{% endblock %}