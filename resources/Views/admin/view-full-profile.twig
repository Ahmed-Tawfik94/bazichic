{% extends 'admin/admin_layout.twig' %}
{% block jstriggers %}
    <script type="text/javascript">
        $(document).ready(function () {

            $('#autogenerate_txn').change(function () { // var autogenerate_pass = $(this).val();
                if ($('input#autogenerate_txn').is(':checked')) {
                    document.getElementById("txn_id").style.display = 'none';
                } else {
                    document.getElementById("txn_id").style.display = 'block';
                }
            });

            $('#plan_id').change(function () {
                var selectedPlan = $(this).val();
                if (selectedPlan === 2) {
                    document.getElementById("planTypeArea").style.display = 'block';
                } else {
                    document.getElementById("planTypeArea").style.display = 'none';
                }

            });

        });
    </script>
{% endblock %}
{% block content %}
    <div class="row p-3">

        <!-- Profile -->
        <div
                class="col-lg-12 col-md-12 m-0 p-0">
            <!-- Contact -->
            <div class="boxed-widget" style="background-color:#ffffff;">
                <div class="hosted-by-title">
                    <h3 style="border-bottom: 0px solid #e8e8e8;">
                        <a style="color:#444444;font-weight:500;"
                           href="{{ base_url() }}/profile/{{ page.thisUser.user_name }}">{{ page.thisUser.first_name }}
                            {{ page.thisUser.last_name }}</a>
                        <span>{{ page.thisUser.last_seen }}</span>
                    </h3>
                    <a href="#" class="hosted-by-avatar">

                        {% if page.thisUser.user_image %}
                            <img id="profilePreview"
                                 src="/{{ page.thisUser.user_image }}?d=mm&amp;s=70"
                                 class="NO-CACHE"
                                 alt="{{ page.thisUser.user_name }}"
                            >
                        {% else %}
                            <img id="profilePreview" src="{{ base_url() }}/images/avatar.jpg" alt="placeholder">
                        {% endif %}
                    </a>
                </div>
                <ul class="listing-details-sidebar">
                    <li style="color:#444444;font-weight:500;">
                        <i class="fa fa-trophy"></i>
                        Loyalty Points:
                        {{ page.thisUser.loyalty_points }}</li>
                    <li style="color:#444444;font-weight:500;">
                        <i class="fa fa-birthday-cake"></i>
                        DOB:
                        {{ page.thisUser.dob }}</li>
                    <!--
														     {% if page.isMembershipActive %}
														    <li><i class="sl sl-icon-shield"></i> Active Plan : {{ page.activePlans.plan_name }}</li>
														    {% endif %}
														    -->
                    <li style="color:#444444;font-weight:500;">
                        <i class="fa fa-globe"></i>
                        Country:
                        {{ page.thisUser.country }}</li>
                    <li style="color:#444444;font-weight:500;">
                        <i class="fa fa-envelope-o"></i>
                        Email:
                        <a href="#">{{ page.thisUser.email }}</a>
                    </li>
                    {% if page.thisUser.last_active %}
                        <li style="color:#444444;font-weight:500;">
                            <i class="fa fa-clock-o"></i>
                            Last Active :
                            {{ page.thisUser.last_active }}</li>
                    {% endif %}
                </ul>

                <a href="{{ full_url_for('update-user-profile',{username:page.thisUser.user_name}) }}"
                   class="send-message-to-owner button text-decoration-none btn btn-success">
                    <i class="sl sl-icon-pencil"></i>
                    Edit Profile</a>
            </div>
            <!-- Contact / End-->
        </div>

        {% set hasActivePlans = page.activePlans|length > 0 %}
        {% set hasActiveTrial = page.thisUser.activeTrial|length > 0 %}
        <!--Show Active Plans-->
        {% if hasActivePlans %}
            <div class="col-lg-12 col-md-12 m-0 p-0">
                <div class="dashboard-list-box margin-top-10">
                    <h4 class="gray">
                        <i class="sl sl-icon-shield"></i>
                        Active Subscription</h4>
                    <div class="dashboard-list-box-static">
                        <div class="table-responsive" style="margin:4px;">
                            <table id="datatable1" class="table table-striped" cellspacing="0" width="100%"
                                   style="background-color:#ffffff;">
                                <thead>
                                <tr>
                                    <th>Subscription Plan</th>
                                    <th>Subscription Date</th>
                                    <th>Expiry Date</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td style="color:#444444;font-weight:600;">{{ page.activePlans.plan_name }}</td>
                                    <td style="color:#444444;font-weight:600;">{{ page.activePlans.date_created }}</td>
                                    <td style="color:#444444;font-weight:600;">{{ page.activePlans.date_expiring }}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center p-0">
                <!-- Add Membership Dialog -->
                <div id="small-dialog" class="zoom-anim-dialog mfp-hide">
                    <div class="small-dialog-header">
                        <h3>Assign Subscription Plan</h3>
                    </div>
                    <div id="formOverlay" style="display:none;">
                        <div style="margin: 30px; text-align: center;">
                            <img src="{{ base_url() }}/images/preloader.gif" alt="preloader" width="60"/>
                            <h4>
                                <strong>Creating Subscription</strong>
                            </h4>
                            <h5>Please wait...</h5>
                            <div id="login_msg"></div>
                        </div>
                    </div>
                    <form method="POST" role="form" name="assignSubscriptionForm" id="assignSubscriptionForm"
                          action="{{ full_url_for('assign-subscription') }}">
                        <div class="message-reply margin-top-0">
                            <input type="hidden" name="user_id" id="user_id" value="{{ page.thisUser.id }}">
                            <label for="plan_id" style="margin-top: 0px;font-weight:bold;">Select Subscription
                                Plan</label>
                            <select class="chosen-select-no-single" name="plan_id" id="plan_id" required="required">
                                {#                                <option label="blank">Select a plan</option> #}
                                {% if page.allPlans %}
                                    {% for plan in page.allPlans %}
                                        <optgroup label="{{ plan.name }}">
                                            {% for item in plan.items %}
                                                <option value="{{ item.price_id }}"{% if not item.is_available %} disabled {% endif %}>{{ plan.name }}
                                                    ({{ item.price }} / {{ item.interval }})
                                                </option>
                                            {% endfor %}
                                        </optgroup>

                                    {% endfor %}
                                {% endif %}
                            </select>
                        </div>
                        <div class="message-reply mt-2">
                            <label for="remark">Remark</label>
                            <textarea name="remark" id="remark" cols="30" rows="3"></textarea>
                        </div>

                        <div class="padding-top-15">
                            <button class="send-message-to-owner button">Invoice Customer</button>
                        </div>
                    </form>
                </div>
                <!-- Add Membership Dialog -->
            </div>
        {% endif %}
        <!--Show Active Plans-->
        {% if not (hasActivePlans  or hasActiveTrial) %}
                    <div class="boxed-widget w-100 mt-3"
                         style="background-color:#ffffff;padding:30px;text-align:center;">
                        <p style="padding-bottom: 4px;margin-top:25px;color:#333;font-weight:bold;">Looks like there is
                            no subscription associated with this account.</p>
                        <a href="#small-dialog" class="button btn btn-purple text-white popup-with-zoom-anim btn btn-success text-decoration-none">
                            <i class="sl sl-icon-shield"></i>
                            Assign Membership</a>
                    </div>
        {% endif %}


        {#        <!Show Free Trials--> #}
        {% if hasActiveTrial %}
            <div class="col-lg-12 col-md-12 m-0 p-0">
                <div class="dashboard-list-box margin-top-10">
                    <h4 class="gray">
                        <i class="sl sl-icon-plane"></i>Active Free Trial</h4>
                    <div class="dashboard-list-box-static">
                        <div class="table-responsive" style="margin:4px;">
                            <table id="datatable1" class="table table-striped" cellspacing="0" width="100%"
                                   style="background-color:#ffffff;">
                                <thead>
                                <tr>
                                    <th>Subscription Plan</th>
                                    <th>Trial Start Date</th>
                                    <th>Expiry Date</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.plan_name }}</td>
                                    <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.date_created }}</td>
                                    <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.date_expiring }}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            {# {% else %} #}
        {% endif %}
        <!--Show Free Trials-->
        <!-- My subscription history -->
        {% if hasActiveTrial %}
            <div class="col-lg-12 col-md-12 m-0 p-0">
                <div class="dashboard-list-box margin-top-10 margin-bottom-20">
                    <h4 class="gray">Trials Summary</h4>
                    <div class="dashboard-list-box-static">

                        <div class="row">
                            <div class="col-lg-12 center">
                                <div class="table-responsive" style="margin-top:20px;">
                                    <table id="datatable1" class="table table-striped table-bordered" cellspacing="0"
                                           width="100%" style="background-color:#ffffff;">
                                        <thead>
                                        <tr>
                                            <th>Subscription Plan</th>
                                            <th>Trial Start Date</th>
                                            <th>Expired</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr>
                                            <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.plan_name }}</td>
                                            <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.date_created }}</td>
                                            <td style="color:#444444;font-weight:600;">{{ page.thisUser.activeTrial.date_expiring }}</td>
                                        </tr>


                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
        <!-- End of My subscription history -->
        <!----Show Free Trials----->


        <!-- My subscription history -->
        {% if page.thisUser.my_plans|length > 0 %}
            <div class="col-lg-12 col-md-12 m-0 p-0">
                <div class="dashboard-list-box margin-top-10 margin-bottom-20">
                    <h4 class="gray">Subscription History</h4>
                    <div class="dashboard-list-box-static">
                        <div class="row">
                            <div class="col-lg-12 center">
                                <div class="table-responsive" style="margin-top:20px;">
                                    <table id="datatable1" class="table table-striped table-bordered" cellspacing="0"
                                           width="100%" style="background-color:#ffffff;">
                                        <thead>
                                        <tr>
                                            <th>Subscription Plan</th>
                                            <th>Subscription Date</th>
                                            <th>Expiry Date</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr>
                                            <td>{{ page.thisUser.my_plans.plan_name }}</td>
                                            <td>{{ page.thisUser.my_plans.date_created }}</td>
                                            <td>{{ page.thisUser.my_plans.date_expiring }}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
        <!-- End of My subscription history -->


    </div>
{% endblock content %}
