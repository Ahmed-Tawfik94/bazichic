{% extends 'admin/admin_layout.twig' %}
{% block content %}
	<div class="row">
		<div class="col-lg-12">
			<div
				id="add-listing">
				<!-- Section -->
				<div
					class="add-listing-section">

					<!-- Headline -->
					<div class="add-listing-headline">
						<h3>
							<i class="sl sl-icon-doc"></i>
							Add Membership Plan</h3>
					</div>


					<form
						method="POST" id="createMembershipForm" name="createMembershipForm" action="{{base_url()}}/membership/create" class="form-horizontal">
						<!-- Title -->
						<div class="row with-forms">
							<div class="col-md-12">
								<h5>Plan Title
									<i class="tip" data-tip-content="Title for your plan"></i>
								</h5>
								<input class="search-field" type="text" name="title" id="title" placeholder="Plan title here" required/>
							</div>
						</div>

						<!-- Intro -->
						<div class="row with-forms">
							<div class="col-md-12">
								<h5>Short Tagline
									<i class="tip" data-tip-content="A short tagline"></i>
								</h5>
								<input class="search-field" type="text" name="tagline" id="tagline" type="text" value="" placeholder="Enter a tag (Optional)"/>
							</div>
						</div>

						<!-- Description -->
						<div class="form">
							<h5>Plan Features
								<i class="tip" data-tip-content="Write up the features of this plan in formatted list."></i>
							</h5>
							<textarea class="WYSIWYG" name="membersip_desc" cols="40" rows="3" spellcheck="true" required></textarea>

						</div>

						<div
							class="row with-forms">

							<!-- Phone -->
							<div class="col-md-4">
								<h5>Price
									<span>(in $)</span>
								</h5>
								<input type="text" name="price" pattern="\d*">
							</div>

							<!-- Website -->
							<div class="col-md-4">
								<h5>Duration
									<span>(in Days)</span>
								</h5>
								<input type="text" name="duration" pattern="\d*">
							</div>

							<div class="col-md-4">
								<h5>Sort Order
								</h5>
								<input type="text" name="sort_order" pattern="\d*">
							</div>

						</div>


						<input type="hidden" name="note" value="">

						<div class="row with-forms">
							<div class="checkboxes margin-top-10">
								<input  type="hidden" name="is_available" value="0">
								<input id="is_available" type="checkbox" name="is_available" value="1">
								<label for="is_available">Publish this plan and make it available to the public.</label>
							</div>
						</div>

						<div class="row with-forms">
							<div class="checkboxes margin-top-10">
								<input  type="hidden" name="is_highlighted" value="0">
								<input id="is_highlighted" type="checkbox" name="is_highlighted" value="1">
								<label for="is_highlighted">Highlight this plan and make it standout among others.</label>
							</div>
						</div>


						<button type="submit" class="button btn btn-purple text-white preview">
							<i class="fa fa-arrow-circle-right"></i>
							Create a Plan</button>

					</div>
					<!-- Section / End -->
				</form>
			</div>
		</div>
	</div>

{% endblock content %}
