                    ['table', ['table']],
                    //[ 'insert', [ 'link'] ],
                    ['view', ['undo', 'redo', 'fullscreen', 'codeview', 'help']]
                ]
            });

            $('#selectFaqCategory').on('change', async function () {
                const loading = $('#loadingCategories');
                const selectSavedStatus = await $(this).val();
                loading.show()
                // console.log("Selected: " + selectSavedStatus);
                const subjectSelect = $('#selectFaqSubCategory').empty();
                const subjects_url = '/admin/apis/faqsubcategories/list/' + selectSavedStatus;
                $.get(subjects_url)
                    .done(function (data) {
                        loading.hide();

                        if (!data.result || !Array.isArray(data.result)) {
                            console.warn("Invalid response format");
                            return;
                        }

                        const options = data.result.map(item => `<option value="${item.id}">${item.title}</option>`).join('');
                        subjectSelect.html(options);
                        subjectSelect.prop("disabled", false)
                    })
                    .fail(function (xhr, status, error) {
                        loading.hide();
                        console.error("Error loading subjects:", error);
                    });

            });
