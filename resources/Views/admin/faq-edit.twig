{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div id="add-listing">

                <div id="faqFormOverlay" style="display:none;">
                    <div style="margin: 30px; text-align: center;">
                        <img src="{{ base_url() }}/images/preloader.gif" width="60"/>
                        <h4><strong>Updating FAQ ...</strong></h4>
                        <h5>Please wait...</h5>
                        <div id="login_msg"></div>
                    </div>
                </div>

                <form role="form" name="updateFAQForm" id="updateFAQForm" action="{{ full_url_for('update-faq') }}"
                      method="POST">
                    <!-- Section -->
                    <div class="add-listing-section">

                        <!-- Headline -->
                        <div class="add-listing-headline">
                            <h3><i class="sl sl-icon-doc"></i> Update FAQ</h3>
                        </div>

                        <input type="hidden" name="id" value="{{ page.faqEntry.id }}" required/>
                        <!-- Title -->
                        <div class="row with-forms">
                            <div class="col-md-12">
                                <label for="title">FAQ Title * <i class="tip" data-tip-content="Enter title for this FAQ"></i></label>
                                <input class="search-field" type="text" name="title" id="title"
                                       value="{{ page.faqEntry.title }}" placeholder="FAQ Title" required/>
                            </div>
                        </div>


                        <div id="loadingCategories" style="display:none;padding:6px 12px;text-align:center;margin:0 auto;background-color:#284F4A;width: fit-content;
    height: fit-content;border-radius:14px;"><span style="color:white;padding-bottom: 4px;">Loading categories</span>
                        </div>

                        <div class="row with-forms">
                            <!-- Status -->
                            <div class="col-md-6">
                                <label for="selectFaqCategory">Select Category <span>*</span> <i class="tip"
                                                                      data-tip-content="Choose a suitable category"></i>
                                </label>
                                <select class="chosen-select-no-single" name="category_id" id="selectFaqCategory"
                                        required>
                                    <option value="">Select a category</option>
                                    {% if page.categories %}
                                        {% for category_row in page.categories %}
                                            <option value="{{ category_row.id }}"
                                                    {% if page.faqEntry.category_id == category_row.id %}selected{% endif %}>{{ category_row.title }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label for="selectFaqSubCategory">Select Sub-category <span>*</span> <i class="tip" data-tip-content="Select a Sub-category"></i></label>
                                <select class="" name="subcategory_id" id="selectFaqSubCategory" disabled>
                                    <option value="">Select a category</option>
                                    {% for category_row in page.subCategories %}
                                        <option value="{{ category_row.id }}" {% if page.faqEntry.subcategory_id == category_row.id %}selected{% endif %}>{{ category_row.title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <!-- Row / End -->


                        <!-- Intro -->
                        <div class="row with-forms">
                            <div class="col-md-12">
                                <label for="summernote">FAQ Content * <i class="tip" data-tip-content="Write the FAQ content in detail"></i>
                                </label>
                                <textarea id="summernote" name="editordata" name="description" class="WYSIWYG">
								     {{ page.faqEntry.description | raw }}
								 </textarea>

                                <textarea class="WYSIWYG" style="display:none;" name="description" cols="40" rows="3"
                                          id="description" spellcheck="true"
                                          placeholder="Write the FAQ content">{{ page.faqEntry.description|raw }}</textarea>

                            </div>
                        </div>

                        <div class="row with-forms">
                            <div class="checkboxes margin-top-10 margin-left-10">
                                <input id="is_published" type="checkbox" name="is_published" value="1"
                                       {% if page.faqEntry.is_published > 0 %}checked{% endif %}>
                                <label for="is_published">Publish this FAQ and make available to the public.</label>
                            </div>
                        </div>


                        <button type="submit" class="button btn btn-purple text-white preview"><i class="fa fa-arrow-circle-right"></i> Update FAQ
                        </button>

                    </div>
                    <!-- Section / End -->
                </form>
            </div>
        </div>
    </div>

{% endblock content %}