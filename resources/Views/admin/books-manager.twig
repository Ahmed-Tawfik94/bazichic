{% extends 'admin/admin_layout.twig' %}
{% block jstriggers %}
	<script type="text/javascript" src=" https://code.jquery.com/jquery-3.3.1.js"></script>
	<link href="https://cdn.datatables.net/v/bs4/jq-3.7.0/jszip-3.10.1/dt-2.2.1/af-2.7.0/b-3.2.1/b-colvis-3.2.1/b-html5-3.2.1/b-print-3.2.1/cr-2.0.4/date-1.5.5/fc-5.0.4/fh-4.0.1/kt-2.12.1/r-3.0.3/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.1/sp-2.3.3/sl-3.0.0/sr-1.4.1/datatables.min.css" rel="stylesheet">

	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
	<script src="https://cdn.datatables.net/v/bs4/jq-3.7.0/jszip-3.10.1/dt-2.2.1/af-2.7.0/b-3.2.1/b-colvis-3.2.1/b-html5-3.2.1/b-print-3.2.1/cr-2.0.4/date-1.5.5/fc-5.0.4/fh-4.0.1/kt-2.12.1/r-3.0.3/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.1/sp-2.3.3/sl-3.0.0/sr-1.4.1/datatables.min.js"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			$('#documents_table').DataTable({
				responsive:true,
				data: {{ page.data | json_encode | raw }},
				columns: [
					{
						data: 'cover',
						name: 'cover',
						title:'Cover',
						render: function(data, type, row, meta) {
							// Custom rendering for 'cover' column
							return  data ?`<img src="/${data}" alt="${row.title}" width="75"  />`
									:'<img src="/images/books/default.png" width="75" alt="placeholder">';
						}
					},
					{
						data: 'title',
						name: 'title',
						title:'Title',
						render:function (data,type,row, meta){
							console.log(row)
							return `<p class="my-1 pb-2 font-weight-bold">${row.title}</p>
<div style="font-size:14px;" class="my-1 pb-2">File: ${row.file_type}</div>
<div style="font-size:14px;" class="my-1 pb-2">
    Note: ${row.note ? (Math.round(row.note * 100) / 100) + "MB" : ""}
</div>

${row.date_updated ? `
    <div style="font-size:14px;" class="my-1 pb-2">Last Updated:
        <small>${row.date_updated}</small>
    </div>
` : ""}

${row.is_downloadable ?
									`<span class="badge badge-pill badge-info">Downloadable</span>` : ""}

${row.is_published === 0 ?
									`<span class="badge badge-pill badge-danger">Not Published</span>` : ""}
`
						}
					},
					{
						data:'category',
						name:'category',
						title:'Category'
					},
					{
						data:'num_likes',
						name:'num_likes',
						title:"Likes"
					},
					{
						data:'num_saves',
						name:'num_saves',
						title:'Saves'
					},
					{
						data:'avg_rating',
						name:'avg_rating',
						title:'Rating',
					},
					{
						data:'num_reviews',
						name:'num_reviews',
						title:'Reviews'
					},
					{
						data: null, // No data from API, manually generated
						title:'Actions',
						orderable: false,
						searchable: false,
						render: function (data, type, row) {
							const code = row.qcode
							const view = `/admin/documents/book-detail/${code}`
							const edit =`/admin/documents/edit-document/${code}`
							return `<a href="${view}" target="_blank" class="btn btn-link text-primary text-decoration-none">
						<i class="sl sl-icon-share-alt"></i></a>
					<a href="${edit}" class="btn btn-link text-warning text-decoration-none">
						<i class="sl sl-icon-note"></i></a>
						<a href="#" class="btn btn-link text-danger deleteDocument text-decoration-none" data-id="${row.qcode}">
						<i class="sl sl-icon-trash"></i></a>
                `;
						}
					}
				]
			});
});
	</script>
{#	<style>#}
{#		/*.table > tbody > tr > td {*/#}
{#		/*	font-size: 14px;*/#}
{#		/*}*/#}
{#	</style>#}
{% endblock %}
{% block content %}

		<div class="row py-3 justify-content-end" style="gap:1rem">
			<a class="btn btn-outline-success rounded-pill text-decoration-none px-4 py-2" href="{{ full_url_for('add-document',{doc_type:'ebook'}) }}"><i class="sl sl-icon-book-open pr-2"></i> Create E-book</a>
			<a class="btn btn-outline-success rounded-pill text-decoration-none px-4 py-2" href="{{ full_url_for('add-document',{doc_type:'magazine'}) }}"><i class="sl sl-icon-layers pr-2"></i>Create Magazine</a>
		</div>
	<hr/>
	{% if page.data|length > 0 %}
		<div class="row ">
			<div class="col-12">
				{% include 'list_items/documents_data_table.twig' %}
			</div>
		</div>
	{% else %}
		<section
			class="d-flex flex-column h-100">
			<!-- Search -->
			<div class="p-4 d-flex justify-content-end align-items-center">
				<a href="{{full_url_for('select-document-type')}}" class="btn btn-success btn-lg rounded-pill">Create New Document</a>
			</div>
			<!-- Search Section / End -->
			<div class="d-flex flex-column justify-content-center align-items-center h-100">
				<h2 style="text-align: center;font-size: 100px;line-height: 110px;font-weight: 500;">
					<i class="sl sl-icon-layers"></i>
				</h2>
				<h4>You have not added any document yet.</h4>
			</div>
		</section>
	{% endif %}

{% endblock %}
