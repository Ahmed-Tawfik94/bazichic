{% extends 'admin/admin_layout.twig' %}
{% block jstriggers %}
{#<link rel="stylesheet" href=" https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/css/bootstrap.css">#}
{#<link rel="stylesheet" href="https://cdn.datatables.net/1.10.20/css/dataTables.bootstrap4.min.css">#}
<script type="text/javascript" src=" https://code.jquery.com/jquery-3.3.1.js"></script>
    <link href="https://cdn.datatables.net/v/bs4/jq-3.7.0/jszip-3.10.1/dt-2.2.1/af-2.7.0/b-3.2.1/b-colvis-3.2.1/b-html5-3.2.1/b-print-3.2.1/cr-2.0.4/date-1.5.5/fc-5.0.4/fh-4.0.1/kt-2.12.1/r-3.0.3/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.1/sp-2.3.3/sl-3.0.0/sr-1.4.1/datatables.min.css" rel="stylesheet">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/v/bs4/jq-3.7.0/jszip-3.10.1/dt-2.2.1/af-2.7.0/b-3.2.1/b-colvis-3.2.1/b-html5-3.2.1/b-print-3.2.1/cr-2.0.4/date-1.5.5/fc-5.0.4/fh-4.0.1/kt-2.12.1/r-3.0.3/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.1/sp-2.3.3/sl-3.0.0/sr-1.4.1/datatables.min.js"></script>
{#<script type="text/javascript" src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>#}
{#<script type="text/javascript" src="https://cdn.datatables.net/1.10.20/js/dataTables.bootstrap4.min.js"></script>#}
<script type="text/javascript">
     $(document).ready(function () {
         $('#example').DataTable({
             processing: true, // Show a loading indicator
             serverSide: true, // Enable server-side processing
             responsive: true,
             "order": [[ 0, "desc" ]],
             ajax: {
                 url: '{{ full_url_for('retrieve-users') }}', // Your API endpoint
                 type: "GET",
                 data: function (d) {
                     // Append additional parameters (if needed)
                     d.customFilter = $('#filterInput').val();
                 },
                 error: function(xhr, error, thrown) {
                     // Custom error handling logic
                     console.log('Error occurred during the API call: ', error);
                     console.log('XHR object:', xhr);
                     console.log('Thrown error:', thrown);

                     // Show a custom error message to the user
                     toastr.error('An error occurred while fetching the data. Please try again later.');

                     // // Optionally, you can display a message in a specific DOM element
                     // $('#error-message').text('There was an issue with fetching data. Please try again.');
                     //
                     // // Optionally, you can hide the table to prevent showing incomplete data
                     // $('#example').hide();
                 }
             },
             columns: [
                 { data: "id",
                     name:'id'
                 },
                 { data: "name" ,
                     name:'name'
                 },
                 { data: "email" ,
                     name:'email'
                 },
                 { data: "loyalty_points" ,
                     orderable: false,
                     searchable: false,
                 },
                 { data: "status",
                     orderable: false,
                     searchable: false,
                 },
                 { data: "country",
                     orderable: false,
                     searchable: false,
                 },
                 { data: "membership_info",
                     orderable: false,
                     searchable: false,
                 },
                 { data: "date_created" ,
                     type:'date',
                    name:"created_at"
                 },
                 { data: "last_seen",
                 name:'last_active'
                 },
                 {
                     data: null, // No data from API, manually generated
                     orderable: false,
                     searchable: false,
                     render: function (data, type, row) {
                         return `<a href="/admin/users/view-profile/${row.user_name}" data-id="${row.id}" title="View Profile" class="text-info action-icon btn-link" >
								<i class="sl sl-icon-share-alt"></i>
							</a>
							<a href="/admin/users/profile/${row.user_name}" data-id="${row.id}" title="Edit Account" class="text-warning action-icon btn-link" >
								<i class="sl sl-icon-note"></i>
							</a>
							<button  data-id="${row.id}" class="deleteUser text-danger action-icon btn-link" title="Delete Account"  >
								<i class="sl sl-icon-trash"></i>
							</button>
                `;
                     }
                 }
             ],
             pageLength: 25, // Set the default page size
             lengthMenu: [10, 25, 50, 100] // Allow changing page size
         });
         $(document).on("click", ".deleteUser", function() {
             let id = $(this).data("id");
             swal({
                 title: "Delete User",  // Default title
                 text: "Are you sure you want to delete this user account permanently?", // Default text
                 type: "warning",
                 showCancelButton: true,
                 confirmButtonColor: "#3085d6",
                 cancelButtonColor: "#d33",
                 confirmButtonText: "Confirm",
             }).then((result) => {
                 if (result.value) {
                     var formData = JSON.stringify({ user_id:id })
                     $.ajax({
                         url: "{{ full_url_for('delete-user') }}",
                         type: "POST",
                         data: formData,
                         beforeSend: function (request) {
                             request.setRequestHeader("Authorization", authorization);
                         },
                         processData: false,
                         contentType: 'Application/json',
                         dataType: "json",
                         success: function (data) {
                             if (data.error) {
                                 toastr.error(data.message);
                             } else {
                                 toastr.success(data.message);
                                 $('#example').DataTable().ajax.reload();
                             }
                         },
                         error: function (xhr, ajaxOptions, thrownError) {
                             if (xhr.responseJSON) {
                                 // Assuming the response has an error message in 'message' key
                                 toastr.error(xhr.responseJSON.message || xhr.responseText);
                             } else {
                                 toastr.error(xhr.responseText);  // Fallback if JSON is not returned
                             }
                         },
                     });
                 }
             })
         });
      handleClick('.deleteUser',"{{ full_url_for('delete-user') }}",authorization,'Delete User',"Are you sure you want to delete this user account permanently?")
     });
</script>
<style>
.table > tbody > tr > td{
        font-size:14px;
}
</style>
{% endblock %}
{% block content %}
<div class="row clearfix margin-bottom-20">
    <div class="d-flex justify-content-end align-items-center my-2 w-100 border-bottom py-2">
        <a href="{{ full_url_for('create-new-account') }}" class="btn btn-outline-success">+ Add new User</a>
    </div>
<div class="col-lg-12 col-md-12 my-4">
    {% include 'list_items/users_data_table.twig' %}

</div>
{% endblock %}