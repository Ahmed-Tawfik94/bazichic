{% extends 'admin/admin_layout.twig' %}
{% block jstriggers %}
    <style>
        #myProgress {
            width: 100%;
            background-color: grey;
        }

        #myBar {
            width: 1%;
            height: 30px;
            background-color: green;
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {

            handleFormSubmit('#bannerUploadForm', '#uploading_overlay', authorization, 'Upload Banner', "Are you sure that you want to set this image as home banner?", '#myProgress')
        });
    </script>
{% endblock %}

{% block content %}
    <div class="row vh-100">
    <!-- Profile -->
    <div class="col-lg-12 col-md-12">
        <div class="dashboard-list-box margin-top-0">
            <h4 class="gray">Site Settings</h4>
            <div class="dashboard-list-box-static">
                <div id="uploading_overlay" style="display:none;">
                    <div style="padding:60px;text-align: center;">
                        <img src="{{ base_url() }}/images/preloader.gif" width="70" alt="preloader"/>
                        <h3 style="color:#121212;margin-top:30px;">
                            <strong>Uploading Banner</strong>
                        </h3>
                        <h4 style="color:#232323;">Please wait...</h4>


                    </div>
                </div>
                <form
                        id="bannerUploadForm" name="bannerUploadForm" action="{{ full_url_for('settings-update') }}"
                        class="form-horizontal" enctype="multipart/form-data" method="POST" style="display:block;">
                    <div class="row with-forms">
                        <div class="col-md-12 text-center">
                            <h4>Upload Profile Picture</h4>
                            <div class="position-relative d-inline-block my-2 ">
                                <!-- Profile Image -->
                                <img id="logo_image_preview" src="/images/logo.png"
                                     class="rounded-circle border"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     alt="Profile Image">

                                <!-- Floating Upload Button -->
                                <div class="position-absolute" style="bottom: 10px; right: 10px;">
                                    <label class="btn btn-primary btn-sm rounded-circle shadow"
                                           style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                                        <i class="fa fa-upload"></i>
                                        <input type="file" id="logo_image" name="logo_image" class="d-none" onchange="logoPreview();">
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Row -->
                    <div class="row with-forms">
                        <div class="col-md-12">
                            <h4>Upload Home Page Main Banner.</h4>
                            <div class="edit-profile-photo ">
                                {% if page.settings.banner_link %}
                                    <img id="cover_image_preview" src="{{ base_url() }}/{{ page.settings.banner_link }}"
                                         style="width:100%;max-height:500px;" alt="cover_image">
                                {% else %}
                                    <img id="cover_image_preview" src="https://placehold.co/1080x1920?text=Cover+Banner"
                                         alt="placeholder">
                                {% endif %}
                                <div class="change-cover-btn">
                                    <div class="coverUpload">
                                        <span><i class="fa fa-upload"></i></span>
                                        <input type="file" id="cover_image" name="cover_image" class="upload"
                                               onchange="docImgPreview();"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- Row / End -->
                    <div class="row">
                        <div class="col-lg-6">
                            <label for="website_name">Website Name</label>
                            <input type="text" id="website_name" name="website_name"
                                   value="{% if page.settings.name %}{{ page.settings.name }}{% endif %}">
                        </div>
                        <div class="col-lg-6">
                            <label for="website_email">Admin Email</label>
                            <input type="text" id="website_email" name="website_email"
                                   value="{% if page.settings.admin_email %}{{ page.settings.admin_email }}{% endif %}">
                        </div>
                    </div>
                    <!-- Row / End -->
                    <div class="row">
                        <div class="col-lg-6">
                            <label for="phone">Phone Number</label>
                            <input type="text" id="phone" name="phone"
                                   value="{% if page.settings.phone %}{{ page.settings.phone }}{% endif %}">
                        </div>
                        <div class="col-lg-6">
                            <label for="site_email">Contact Email</label>
                            <input type="text" id="site_email" name="site_email"
                                   value="{% if page.settings.site_email %}{{ page.settings.site_email }}{% endif %}">
                        </div>
                    </div>
                    <!-- Maintenance Mode -->
                    <div class="custom-control custom-checkbox mt-3">
                        <input id="website_maintenance" type="checkbox" name="website_maintenance"
                               class="custom-control-input"
                               value="1" {% if page.settings.maintenance_on %} checked {% endif %}>
                        <label for="website_maintenance" class="custom-control-label">Maintenance Mode</label>
                    </div>
                    <div class="row">
                        <button type="submit" id="bannerUploadBtn" class="button btn btn-purple text-white margin-top-15">Save
                            Changes
                        </button>
                    </div>
                </form>

                <!-- Progress Bar -->
                <div id="myProgress" class="progress mt-4 d-none">
                    <div id="myBar" class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <span id="myBarTxt" class="text-white"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>
{% endblock content %}
