		<div class="row"> <div class="col-md-12">
			<div class="checkboxes in-row margin-bottom-20">
				<input id="notify_account" type="checkbox" name="notify_account" value="1">
				<label for="notify_account" style="color:#333333;">Notify user of this new account via email.</label>
			</div>
		</div>
	</div>

	<div class="clear"></div>

	<div class="col_full nobottommargin text-right" style="margin-top:20px;">
		<button class="button button-3d button-green nomargin" id="register-form-submit" name="register-form-submit" value="register">
			<i class="fa fa-arrow-right"></i>
			Create account
		</button>
	</div>

</form>
