{% extends 'dashboard_layout.twig' %}

{% block title %}{{ plan.title }}{% endblock %}
{% block content %}

{% if page.active_plan %}
<div class="row clearfix">
    <div class="col-12">
        <div class="card border-light bg-white rounded-lg">
            <div class="card-header bg-white border-light pt-4 rounded-top">
                <h3 class="text-capitalize font-weight-bold">Plan & Billing</h3>
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="text-muted">Manage your plan and payments</h6>
                    <form method="POST" action="/create-customer-portal-session">
					<button  type="submit"  class="btn btn-outline-dark  px-3 " style="border-radius: 12px;">Manage billing <i class="sl sl-icon-share-alt ml-2 "></i></button>
				</form>
                </div>
            </div>
            <div class="card-body px-4 px-md-5 py-4">
                <h5 class="card-title font-weight-bold mb-4">Current Plan</h5>
                <div class="row">
                    <div class="col-12 col-md-6 mb-3 mb-md-0">
                        <div class="border p-3 border-light shadow-sm rounded-lg h-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="p-0 m-0 text-muted"><span class="text-capitalize">{{ page.active_plan.interval }}ly</span> Plan</p>
                                <div class="d-flex gap-2" style="gap:12px">
                                    <div class="badge d-flex align-items-center rounded-pill" style="background:#c6f2db; padding: 6px 8px;">
                                        <span class="text-uppercase">{{ page.active_plan.name }}</span>
                                    </div>
                                    <div class="badge d-flex align-items-center rounded-pill" style="background:{{ page.statusColor.background }}; padding: 6px 8px;">
                                        <span class="rounded-circle d-inline-block" style="width: 8px; height: 8px; background: {{ page.statusColor.icon_color }};"></span>
                                        <span class="text-uppercase ml-1" style="color:{{ page.statusColor.text_color }};">{{ page.active_subscription.status }}</span>
                                    </div>
                                </div>
                            </div>
                            <h5 class="pt-2 font-weight-bold">{{ page.active_plan.price }}$/{{ page.active_plan.interval }}ly</h5>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="border p-3 border-light shadow-sm rounded-lg h-100">

                            <div class="grid grid-col-2 gap-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <p class="p-0 m-0 text-muted">Renew At</p>
                                    <h5 class="pt-2 font-weight-bold">{{ page.active_subscription.end_date }}</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 mt-4">

            <div class="card-body">
            <div class="text-center my-4 ">
                <button id="toggle-monthly" class="btn btn-primary active">Monthly</button>
                <button id="toggle-yearly" class="btn btn-secondary">Yearly</button>
            </div>
            <div id="membership-plans-container" class="row"></div>
        </div>
        </div>
    </div>

  </div>

{% elseif page.pending_plan %}
<div class="row clearfix">
<div class="col-lg-12 col-md-12">
	<div class="card border-light bg-white" style="border-radius: 1rem">
		<div class="card-header bg-white border-light pt-4" style="border-radius: 1rem 1rem 0 0;">
			<h3 class="text-capitalize font-weight-bold">plan & billing</h3>
			<div class="d-flex justify-content-between align-items-center">
				<h6 class="text-muted ">Manage your plan and payments</h6>
			</div>
		</div>
		<div class="card-body px-5 py-4">
			<h5 class="card-title font-weight-bold mb-4">Current Plan</h5>
			<div class="d-flex justify-content-between">
				<div class="border p-3 border-light shadow-sm" style="width: 30rem;border-radius: 1rem">
					<div class="d-flex justify-content-between align-items-center">
						<p class=" p-0 m-0 text-muted"> <span class="text-capitalize ">{{ page.active_plan.interval }}ly</span> plan</p>
						<div class="d-flex" style="gap:10px">
							<div  class="badge  d-flex align-items-center rounded-pill" style="gap:10px;padding:6px 8px ; background:#c6f2db">
								<span class="d-inline-block text-uppercase">{{ page.active_plan.name }}</span>
							</div>
							<div  class="badge  d-flex align-items-center rounded-pill" style="gap:10px;padding:6px 8px ; background:#c6f2db;'">
								<span class="rounded-circle d-inline-block " style="width: 8px;height: 8px;background: #329c75"></span>
								<span class="d-inline-block text-uppercase ml-1" style="color:#329c75">{{page.active_subscription.status}}</span>
							</div>
						</div>
					</div>
					<h5 class="pt-2 font-weight-bold">{{ page.active_plan.price }}$/{{ page.active_plan.interval }}ly</h5>
				</div>
				<div class="border p-3 border-light shadow-sm" style="width: 30rem;border-radius: 1rem">
					<div class="d-flex justify-content-between align-items-center">
						<p class=" p-0 m-0 text-muted"> Renew at</p>
					</div>
					<h5 class="pt-2 font-weight-bold">{{page.active_subscription.end_date}}</h5>
				</div>
			</div>
		</div>
		<div class="card-body px-5">
			<div class=" text-right"><a href="{{ base_url() }}/subscription/subscription-plans" class="btn btn-link text-decoration-none" > <i class="fa fa-arrow-right"></i> View All Subscription Plans</a></div>
		</div>
	</div>
  {% else %}
	<div class="card border-light bg-white" style="border-radius: 1rem">
		<div class="card-body px-5 py-4">
			<div style="text-align: center;padding: 20px 0;">
				<h1><i class="sl sl sl-icon-badge"></i></h1>
				<h3 class="margin-top-10">Choose a suitable plan to get started.</h3>
				<p style="padding-bottom: 10px;">Looks like you have not subscribed for any plan yet.</p>
				<a href="{{ base_url() }}/membership" class="button btn btn-purple text-white margin-bottom-20 text-decoration-none" style="padding: 11px 25px;
					font-size: 18px;"> <i class="fa fa-arrow-right"></i> View Plans</a>
			</div>
		</div>

	</div>
{% endif %}
<script id="membership-template"  type="text/template">
<%#plans%>
    <div class="col-12 col-md-6 col-lg-6 mb-4">
        <div class="card mb-4 shadow-sm <%^is_selected%>border-success <%/is_selected%> <%#is_selected%>border-primary <%/is_selected%>  h-100">
            <div class="card-header bg-white border-0 p-3 rounded-top d-flex align-items-center flex-column">
                <h2 class="my-0 font-weight-normal text-uppercase"><%name%></h2>
                <div class="">
                    <span class="bg-success rounded-circle d-inline-block" style="width: 5px; height: 5px;"></span>
                    <span class="bg-success rounded-circle d-inline-block" style="width: 5px; height: 5px;"></span>
                    <span class="bg-success rounded-circle d-inline-block" style="width: 5px; height: 5px;"></span>
                </div>
            </div>
            <div class="card-body p-3">
                <h1 class="card-title pricing-card-title text-center">$<%price%> <small class="text-muted">/ <%interval%>ly</small></h1>
                <%#description%>
                   <div class="my-3 p-3 text-center" style="height: 100px;"><%description%></div>
                <%/description%>
            </div>
            <div class="card-footer bg-white border-0">
                 <%#is_selected%>
                    <button class="btn btn-lg btn-secondary rounded-pill w-100" disabled>Selected</button>
                 <%/is_selected%>
                 <%^is_selected%>
                    <button  class="btn btn-lg btn-outline-success rounded-pill w-100" onclick="handleSwitchAction('<%id%>')" ><% switch_text %></button>
                <%/is_selected%>
            </div>
        </div>
    </div>
    <%/plans%>
</script>

{% endblock content %}

{% block jsfooter %}
<script src="https://unpkg.com/mustache@latest"></script>
<script>
    const customTags = [ '<%', '%>' ];
    Mustache.tags = customTags;
</script>
<script>
        let plansData = JSON.parse('{{ page.membership_plans |json_encode |raw }}')
    $(document).ready(function() {

function renderPlans(type) {
    let template = $("#membership-template").clone(); // Fresh copy of the template

    let plans = plansData[type].map(plan => {
        // Determine column class based on the number of plans
        const colClass = plansData[type].length === 2 ? "6" :
                         plansData[type].length === 3 ? "4" :
                         plansData[type].length === 4 ? "3" : "12";

        // Determine the button text based on selection
        const switchText = plan.is_selected
            ? "Selected"
            : (plansData[type].some(p => p.is_selected) ? "Switch" : "Select Plan");

        // Switch action function
        const switchAction = () => upsert(plan.id);

        return {
            ...plan,
            col_class: colClass,
            switch_text: switchText,
            switch_action: switchAction
        };
    });

    // Render the plans using Mustache
    let templateHtml = template.html(); // Get raw template HTML
    $("#membership-plans-container").html(Mustache.render(templateHtml, { plans }));
}



        // Default to Monthly
        renderPlans("month");

        // Toggle between Monthly & Yearly
        $("#toggle-monthly").click(function() {
            renderPlans("month");
            $("#toggle-monthly").addClass("btn-primary active").removeClass("btn-secondary");
            $("#toggle-yearly").addClass("btn-secondary").removeClass("btn-primary active");
        });

        $("#toggle-yearly").click(function() {
            renderPlans("year");
            $("#toggle-yearly").addClass("btn-primary active").removeClass("btn-secondary");
            $("#toggle-monthly").addClass("btn-secondary").removeClass("btn-primary active");
        });
    });
function handleSwitchAction(planId) {
    // Flatten all values of the plansData object into a single array
    const allPlans = Object.values(plansData).flat();
    debugger
    console.log(allPlans)

    // Find the plan by id
    const plan = allPlans.find(p => p.id === parseInt(planId));
    if (plan && !plan.is_selected) {
        upsert(plan.id)
    }
}
</script>
	<script>
	const url = '{{ full_url_for('update-subscriptions') }}'
	const upsert = (id)=>{
		console.log(id)
		swal({
      title: 'Subscription Update',
      html: "Your Plan Will Update Immediately. \n are you sure you want to continue",
      type: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: 'Yes',
    }).then((result) => {
		if(result.value){
		console.log('action confirmed processing ...')

		console.log(url)
		sendRequest(id)
		}
    })
    }
	const sendRequest = async (id) => {
    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ id })
        });

        if (!res.ok) {
            throw new Error(`HTTP error! Status: ${res.status}`);
        }
		console.log(res)
        const data = await res.json();
        console.log(data);
		swal({
		  title: 'Subscription Updated',
		  html: `${data?.message}`,
		  type: "success",
		  showCancelButton: true,
		  confirmButtonColor: "#3085d6",
		  confirmButtonText: 'OK',
		}).then(({value})=>{
			 window.location.reload()
		})

    } catch (error) {
        console.error('Error:', error);
		swal({
		  title: 'Subscription Error',
		  html: `We Could not update your plan at this moment. please try again later`,
		  type: "error",
		  confirmButtonColor: "#3085d6",
		  confirmButtonText: 'OK',
		}).then(({value})=>{
			 window.location.reload()
		})
    }
};


</script>
{% endblock %}