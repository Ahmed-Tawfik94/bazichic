<script>
 document.getElementById('input-excel').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (event) {
                const data = new Uint8Array(event.target.result);
                const workbook = XLSX.read(data, { type: 'array' });

                // Assuming the first sheet is what we want to render
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];

                // Convert sheet to JSON and create HTML table
                const sheetAsJson = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });
                // const jsonCalendar = XLSX.utils.
                // sheetAsJson = sheetAsJson.unshift()
                // Create HTML Table
                let table = "<table>";
                sheetAsJson.forEach(function (row) {
                    console.log(row[1]);
                    console.log(new Date(row[1]));
                    d=row.join(', \n')
                    table +=`<td>${d}</td> </tr>`;
                });
                table += "</table>";

                // Inject the table into the HTML
                document.getElementById('excel-output').innerHTML = table;
            };

            reader.readAsArrayBuffer(file);
        }
    });
</script>
